# Copy to .env.local and supply values after creating your Sanity project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: used for editing drafts via Sanity; never expose secret API tokens through NEXT_PUBLIC_ vars.

# WhatsApp international phone digits, e.g. 2547XXXXXXXX (without + or spaces).
# This enables direct WhatsApp chat until a WhatsApp link is configured in Sanity.
NEXT_PUBLIC_WHATSAPP_NUMBER=
